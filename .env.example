# Django
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Local development uses SQLite. Set this to False when using Supabase.
USE_SQLITE=True

# Supabase PostgreSQL (session pooler, suitable for Render's IPv4 network).
# Replace YOUR_URL_ENCODED_PASSWORD with the database password from Supabase.
# Percent-encode special characters in the password before putting it in a URL.
# DATABASE_URL=postgresql://postgres.lugghkshvznncrwgoblx:YOUR_URL_ENCODED_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# Alternatively, configure the same connection as separate variables:
# DB_HOST=aws-0-eu-west-3.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.lugghkshvznncrwgoblx
# DB_PASSWORD=replace-with-your-supabase-database-password
# DB_SSLMODE=require

# Keep this at 0 for Supabase's session pooler so Django releases the
# connection after every request instead of exhausting the small client pool.
DB_CONN_MAX_AGE=0

# Deploy-time Django administrator
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
DJANGO_SUPERUSER_PHONE=+255700000001
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User
